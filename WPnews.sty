\newcommand{\rorlink}[1]{\,\href{https://ror.org/#1}{\protect\rorlogo}}
\RequirePackage{etoolbox}
% Indexed affiliation lookup, e.g. for authors listed with an
% "affiliation: 1" index against a separate "affiliations:" list (as
% used by the BioHackrXiv Markdown/pandoc workflow): \wpdefineaffiliation
% registers index -> name, \wpaffiliations{1,2} prints the name(s) for a
% (possibly comma-separated) list of indices, one per line.
\newcommand{\wpdefineaffiliation}[3][]{%
  \ifblank{#1}
    {\expandafter\def\csname wpaffil@#2\endcsname{#3}}
    {\expandafter\def\csname wpaffil@#2\endcsname{#3\,\rorlink{#1}}}}
\newcommand{\wpprintaffiliation}[1]{\csname wpaffil@#1\endcsname\\}
\newcommand{\wpaffiliations}[1]{\forcsvlist{\wpprintaffiliation}{#1}}
% CiTO citation-intention annotation (used by the Markdown/pandoc article
% workflow in article2/, see resources/filters/extract-cito.lua and
% cito-to-biblatex.lua, but equally usable from hand-written LaTeX
% articles): \wpcitoannotate{key}{property} records a CiTO property for a
% bibliography entry; \finentrypunct is biblatex's per-entry hook (fired
% just before each entry's closing punctuation) and is redefined here to
% print "[cito:property]" for entries that have one.
\newcommand{\wpcitoannotate}[2]{\expandafter\def\csname wpcito@#1\endcsname{#2}}
\let\WPnews@origfinentrypunct\finentrypunct
\renewcommand*{\finentrypunct}{%
  \ifcsname wpcito@\thefield{entrykey}\endcsname
    \space\textbf{[cito:\csname wpcito@\thefield{entrykey}\endcsname]}%
  \fi
  \WPnews@origfinentrypunct}
